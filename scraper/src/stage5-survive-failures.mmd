flowchart TD
    A["START: survive failures, report the run\nStage 4 done: 60 validated books"] --> B["start_time = now UTC\nstats = pages_fetched 0, cache_hits 0"]
    B --> C["for each product_url in sorted links\none page at a time"]
    C --> D["fetch_page product_url\nCACHE HIT: read saved HTML\nFETCH: user-agent + timeout + status check"]
    D --> E{"Network failure\ntimeout / cut?"}
    E -- "yes: unknown outcome" --> F["Wait RETRY_WAIT_SECONDS\ntry exactly once more"]
    E -- "no: got a response" --> G{"Status code?"}
    F --> G
    G -- "404 / 403 / other 4xx" --> H["TerminalFetchError\nserver answered, never retry"]
    G -- "5xx, still failing" --> I["RetryableFetchError\nwait, one retry, then give up"]
    G -- "200" --> J["Save HTML to cache\nno cache write on failure"]
    H --> K["Log SKIP url + reason\nappend to failed_pages"]
    I --> K
    K --> L{"More URLs left?"}
    J --> M["extract + normalize + validate\nsame as Stages 3-4"]
    M --> L
    L -- "yes: next book" --> C
    L -- "no: all visited" --> N["clean_data -> books + errors\nwrite books.json + errors.json"]
    N --> O["Write output/run-report.json\nstart, duration, fetched, cache hits\nvalid, invalid, failed pages"]
    O --> Z["CHECKPOINT / REPORT\nrun finishes, 60 good survive\nfailed_pages = 1 with fake URL"]
