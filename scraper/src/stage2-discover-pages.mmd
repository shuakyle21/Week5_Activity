flowchart TD
    A["START: discover_catalogue_pages\nStage 1 already cached page 1"] --> B["page_number = 1\nseen_links = set()"]
    B --> C["Parse current page HTML\nwith BeautifulSoup"]
    C --> D["Collect every book link\nol.products li a img @ href"]
    D --> E["Make each link absolute\nurljoin(current_page_url, href)\nnever string concatenation"]
    E --> F["Add absolute URL to seen_links\nset de-duplicates repeated links"]
    F --> G{"page_number == 3?"}
    G -- "yes: stop after page 3" --> Z["CHECKPOINT / REPORT\ncatalogue_pages = 3\ndiscovered = 60\nunique_urls = 60"]
    G -- "no: still need another page" --> H{"Does site's 'next'\nlink exist?"}
    H -- "yes: page 2 or 3" --> I["page_number += 1\nnext_page_url = next link"]
    H -- "no: stop early" --> Y["CHECKPOINT FAILED\nExpected page 3, but next link\nwas missing before page 3"]
    I --> J["fetch_page(next_page_url)\nCACHE HIT: read saved HTML\nFETCH: request, status 200, save HTML"]
    J --> K{"Was this a real\nnetwork request?"}
    K -- "yes" --> L["Wait at least 500 ms\nbefore the next real request"]
    K -- "no: cache hit" --> M["No network delay required"]
    L --> C
    M --> C