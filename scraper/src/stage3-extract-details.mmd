flowchart TD
    A["START: extract_book_details\nStage 2 done: 60 unique URLs"] --> B["urls = discover_catalogue_pages\nreturn seen_links"]
    B --> C["for each product_url in sorted seen_links\nsource_page = source_page_map[product_url]"]
    C --> D["fetch_page product_url\nCACHE HIT: read saved HTML\nFETCH: request, status 200, save HTML"]
    D --> E{"Was this a real\nnetwork request?"}
    E -- "yes" --> F["Wait at least 500 ms\nuser-agent + timeout + status check"]
    E -- "no: cache hit" --> G["No delay\nread saved copy"]
    F --> H["Parse detail HTML\nwith BeautifulSoup"]
    G --> H
    H --> I["Extract scoped to product area\ndiv.product_main h1 = title\np.price_color = price_text\np.instock.availability = availability_text\np.star-rating class = rating_text"]
    I --> J{"#product_description exists?"}
    J -- "yes" --> K["description = next p text\nstrip whitespace"]
    J -- "no: some books lack it" --> L["description = null\nnever invent text"]
    K --> M["Build raw record: 8 keys\ntitle, product_url, price_text\navailability_text, rating_text\ndescription, source_page, fetched_at UTC"]
    L --> M
    M --> N{"More URLs left?"}
    N -- "yes: next book" --> C
    N -- "no: all 60 visited" --> Z["CHECKPOINT / REPORT\nprint one full raw record\nall 8 keys even when null\ndetail_pages = 60"]
